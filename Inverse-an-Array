import java.util.*;

public class Main {
    public static void inverse(int[] arr, int[] ans, int i) {
        if (i == arr.length) {
            return;
        }

        ans[arr[i]] = i;

        inverse(arr, ans, i + 1);
    }
    public static void main(String args[]) {
        Scanner sc = new Scanner(System.in);

        int N = sc.nextInt();

        int[] arr = new int[N];
        int[] ans = new int[N];

        for (int i = 0; i < N; i++) {
            arr[i] = sc.nextInt();
        }

        inverse(arr, ans, 0);

        for (int i = 0; i < N; i++) {
            System.out.print(ans[i] + " ");
        }
    }
}
