class Solution {
    public int cost(int[] arr) {
        // code here
        int min=Integer.MAX_VALUE;
        int max=Integer.MIN_VALUE;
        int ans=0;
        for(int i=0;i<arr.length;i++){
            if(arr[i]<min){
                min=arr[i];
                
            }
        }
        return min*(arr.length-1);
            
        
    }
}
